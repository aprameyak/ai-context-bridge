{
  "manifest_version": 3,
  "name": "AI Context Bridge",
  "version": "1.0.0",
  "description": "Seamlessly transfer conversations between ChatGPT, Claude, Gemini, and other AI providers",
  "permissions": [
    "scripting",
    "activeTab",
    "clipboardWrite",
    "storage"
  ],
  "host_permissions": [
    "https://chat.openai.com/*",
    "https://chatgpt.com/*",
    "https://claude.ai/*",
    "https://gemini.google.com/*",
    "https://www.perplexity.ai/*",
    "https://www.deepseek.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Context Bridge",
    "default_icons": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chat.openai.com/*", "https://chatgpt.com/*"],
      "js": ["content/chatgpt.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://claude.ai/*"],
      "js": ["content/claude.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://gemini.google.com/*"],
      "js": ["content/gemini.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.perplexity.ai/*"],
      "js": ["content/perplexity.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.deepseek.com/*"],
      "js": ["content/deepseek.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
